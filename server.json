{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jordanburke/dakboard-mcp-server",
  "description": "DAKboard MCP server for managing screens, blocks, devices, loops, and metrics on DAKboard digital dashboards.",
  "repository": {
    "url": "https://github.com/jordanburke/dakboard-mcp-server",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dakboard-mcp-server",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DAKBOARD_API_KEY",
          "description": "DAKboard API key for authentication",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
